def reuseable_if_statement(prompt, next_action_y, next_action_x):
    var = input(prompt).lower()
    if var in ("yes", "y"):
        next_action_y
    elif var in ("no", "no"):
        next_action_x

def user_def():
    username = input("what is your username?")
    USERNAMES = ('Usernames.txt')

    with open(USERNAMES, 'rt') as file:
        all_names = file.readline().strip().split()

    if username in all_names:
        print(f"Welcome back{username}")
        user_data = open(username, 'a')

    elif username not in all_names:
        reuseable_if_statement("would you like to open a new profile?", open_username(file, username), user_data = open("Anonymous.txt", "a"))

    else:
        print("error")
        user_def()

def open_username(file, username):
    file = open("Usernames.txt", "a")
    file.write(username)
    user_data = open(username, 'a')
    print(f"Welcome {username}")
    wanna_spin_some_crates(username, user_data)


